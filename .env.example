# OmniNinja — exemplo de configuração
# Copie para .env.local no desenvolvimento ou cadastre como Secrets/Environment
# Variables no ambiente de deploy. Nunca coloque chaves reais no GitHub.

# OpenAI — backend interno do modelo público OMNINJA
OPENAI_API_KEY=
# Motor privado do produto OMNINJA. O usuário nunca vê este identificador.
# GPT-5.6 suporta Responses API, reasoning.effort e ferramentas modernas.
OMNINJA_MODEL=gpt-5.6
# Variável legada mantida apenas para rotas antigas durante a migração.
OPENAI_MODEL=gpt-5.6
# Opcional: endpoint compatível/proxy corporativo
OPENAI_BASE_URL=https://api.openai.com/v1
# Mantido apenas para rotas legadas enquanto a migração termina.
OPENAI_ENABLE_TEMPERATURE=false

# Browserless — navegador Chromium usado internamente quando necessário
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo
BROWSERLESS_RECONNECT_TIMEOUT_MS=600000
# Segredo HMAC para tickets de takeover legados. Use 32+ caracteres aleatórios.
# Se vazio, NEXTAUTH_SECRET pode ser usado como fallback.
BROWSER_SESSION_SIGNING_SECRET=

# Sandbox / workspace — tools internas de código e arquivos
# local    = sandbox local namespace+proot já existente
# ailab    = container AI Lab/LXD remoto por tarefa
# disabled = shell/filesystem bloqueados
OMNININJA_SANDBOX_PROVIDER=local

# Sandbox local. Em produção, comandos só executam se o host atingir nível 2.
OMNININJA_WORKSPACE_ROOT=/opt/omnininja/workspaces
OMNININJA_SANDBOX_BASE=/opt/omnininja/sandboxes
OMNININJA_SANDBOX_IMAGE=/opt/omnininja/sandbox-base
OMNININJA_SANDBOX_ALLOW_NETWORK=false

# AI Lab remoto. Use o endereço do daemon/túnel AI Lab e o bearer token do
# dashboard. Nunca exponha AILAB_API_TOKEN ao navegador nem faça commit dele.
# O AI Lab padrão usa LXD privilegiado: trate como host de execução separado,
# não como barreira forte para código hostil.
AILAB_BASE_URL=
AILAB_API_TOKEN=
AILAB_PROVISION_TIMEOUT_MS=300000
OMNININJA_AILAB_WORKSPACE=.omnininja-workspace
# Fim de cada tarefa: stop preserva arquivos e libera compute; delete remove o
# container; keep deixa o container rodando. Produção usa stop por padrão.
OMNININJA_AILAB_FINALIZE=stop

PLAYWRIGHT_HEADLESS=true

# URL pública do app. Preencha depois que a hospedagem gerar o endereço final.
NEXT_PUBLIC_APP_URL=
OMNININJA_PUBLIC_BASE=
NEXTAUTH_URL=

# Banco PostgreSQL de produção.
# Exemplo: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=

# Autenticação
NEXTAUTH_SECRET=
