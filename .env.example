# OmniNinja — exemplo de configuração
# Copie para .env.local no desenvolvimento ou cadastre como Secrets/Environment
# Variables no ambiente de deploy. Nunca coloque chaves reais no GitHub.

# OpenAI — backend interno do modelo público OMNINJA
OPENAI_API_KEY=
# Modelo dedicado ao produto OMNINJA. O runtime usa reasoning.effort
# none/low/medium/high, então use um modelo da sua conta que suporte esses níveis.
OMNINJA_MODEL=gpt-5.1
# Variável legada mantida apenas para rotas antigas durante a migração.
OPENAI_MODEL=gpt-5
# Opcional: endpoint compatível/proxy corporativo
OPENAI_BASE_URL=https://api.openai.com/v1
# Mantido apenas para rotas legadas enquanto a migração termina.
OPENAI_ENABLE_TEMPERATURE=false

# Browserless — navegador Chromium usado internamente quando necessário
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo
BROWSERLESS_RECONNECT_TIMEOUT_MS=600000
# Segredo HMAC para tickets de takeover legados. Use 32+ caracteres aleatórios.
# Se vazio, NEXTAUTH_SECRET pode ser usado como fallback.
BROWSER_SESSION_SIGNING_SECRET=

# Sandbox / workspace — tools internas de código e arquivos
OMNININJA_WORKSPACE_ROOT=/opt/omnininja/workspaces
OMNININJA_SANDBOX_BASE=/opt/omnininja/sandboxes
OMNININJA_SANDBOX_IMAGE=/opt/omnininja/sandbox-base
# false por padrão: namespace de rede isolado. Só habilite rede de shell em
# infraestrutura dedicada com regras de egress/SSRF apropriadas.
OMNININJA_SANDBOX_ALLOW_NETWORK=false
PLAYWRIGHT_HEADLESS=true

# URL pública do app (ajuste no deploy)
NEXT_PUBLIC_APP_URL=https://omnininja-agent-os.gbvinidutra.chatgpt.site
OMNININJA_PUBLIC_BASE=https://omnininja-agent-os.gbvinidutra.chatgpt.site

# Banco/autenticação (preencha conforme o ambiente usado pelo projeto)
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://omnininja-agent-os.gbvinidutra.chatgpt.site
