# OmniNinja — exemplo de configuração
# Copie para .env.local no desenvolvimento ou cadastre como Secrets/Environment
# Variables no ambiente de deploy. Nunca coloque chaves reais no GitHub.

# OpenAI — backend interno do modelo público OMNINJA
OPENAI_API_KEY=
# Motor privado do produto OMNINJA. O usuário nunca vê este identificador.
OMNINJA_MODEL=gpt-5.6

# Serviços OpenAI usados internamente conforme a tarefa
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VIDEO_MODEL=sora-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# IDs de Vector Stores separados por vírgula. Se vazio, File Search fica oculto.
OPENAI_VECTOR_STORE_IDS=

# Browserless — navegador Chromium usado internamente quando necessário
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo

# Sandbox / workspace
# local    = sandbox local namespace+proot
# ailab    = container AI Lab/LXD remoto por tarefa
# disabled = shell/filesystem bloqueados
OMNININJA_SANDBOX_PROVIDER=disabled
OMNININJA_WORKSPACE_ROOT=/opt/omnininja/workspaces
OMNININJA_SANDBOX_BASE=/opt/omnininja/sandboxes
OMNININJA_SANDBOX_IMAGE=/opt/omnininja/sandbox-base
OMNININJA_SANDBOX_ALLOW_NETWORK=false

# AI Lab remoto
AILAB_BASE_URL=
AILAB_API_TOKEN=
AILAB_PROVISION_TIMEOUT_MS=300000
OMNININJA_AILAB_WORKSPACE=.omnininja-workspace
OMNININJA_AILAB_FINALIZE=stop

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# URL pública do app
NEXT_PUBLIC_APP_URL=
OMNININJA_PUBLIC_BASE=

# Banco PostgreSQL de produção
DATABASE_URL=

# Usado apenas pelo docker-compose para criar o PostgreSQL local.
# Prefira uma senha longa, aleatória e compatível com URL.
POSTGRES_PASSWORD=
