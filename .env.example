# OmniNinja - Exemplo de configuracao
# Copie este arquivo: cp .env.example .env
# Depois preencha suas chaves obtidas em https://openrouter.ai

OMNININJA_LLM_PROVIDER=openrouter
OMNININJA_LLM_MODEL=anthropic/claude-3.5-sonnet

OPENROUTER_CLAUDE_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_CHATGPT_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_KIMI_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_GROK_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_GEMINI_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX

OMNININJA_HOST=0.0.0.0
OMNININJA_PORT=8000
OMNININJA_DOMAIN=omnininja.duckdns.org
OMNININJA_SEARCH_PROVIDER=duckduckgo

# Browserless (cloud browser) - opcional mas recomendado
# Obtenha em https://browserless.io
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo
