# OmniNinja — exemplo de configuração
# Copie para .env.local no desenvolvimento ou cadastre como Secrets/Environment
# Variables no ambiente de deploy. Nunca coloque chaves reais no GitHub.

# OpenAI — cérebro central do OmniNinja
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Opcional: endpoint compatível/proxy corporativo
OPENAI_BASE_URL=https://api.openai.com/v1
# Alguns modelos de raciocínio não aceitam temperature; deixe false por padrão.
OPENAI_ENABLE_TEMPERATURE=false

# Browserless — navegador Chromium em nuvem
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo

# Sandbox / workspace
OMNININJA_WORKSPACE_ROOT=/opt/omnininja/workspaces
PLAYWRIGHT_HEADLESS=true

# URL pública do app (ajuste no deploy)
NEXT_PUBLIC_APP_URL=https://omnininja-agent-os.gbvinidutra.chatgpt.site
OMNININJA_PUBLIC_BASE=https://omnininja-agent-os.gbvinidutra.chatgpt.site

# Banco/autenticação (preencha conforme o ambiente usado pelo projeto)
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://omnininja-agent-os.gbvinidutra.chatgpt.site
