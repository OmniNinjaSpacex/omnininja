# OmniNinja Agent OS — server configuration
# Copy to .env locally or configure these values in your deployment provider.
# NEVER commit real API keys or tokens.

# Primary AI engine
OMNININJA_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.2
OPENAI_CHAT_MODEL=gpt-5.2

# Public app URL
NEXT_PUBLIC_APP_URL=https://omnininja-agent-os.gbvinidutra.chatgpt.site
OMNININJA_PUBLIC_BASE=https://omnininja-agent-os.gbvinidutra.chatgpt.site

# Browserless cloud browser
BROWSERLESS_API_KEY=
BROWSERLESS_REGION=production-sfo
# Reconnect timeout depends on your Browserless plan.
# Current shared-fleet limits range from 10s to 5min.
BROWSERLESS_RECONNECT_TIMEOUT_MS=10000

# Optional legacy/fallback providers
OPENROUTER_API_KEY=
OPENROUTER_CLAUDE_API_KEY=
OPENROUTER_CHATGPT_API_KEY=
OPENROUTER_KIMI_API_KEY=
OPENROUTER_GROK_API_KEY=
OPENROUTER_GEMINI_API_KEY=

# Workspace / sandbox
OMNININJA_WORKSPACE_ROOT=/opt/omnininja/workspaces
PLAYWRIGHT_HEADLESS=true

# Legacy host settings (optional)
OMNININJA_HOST=0.0.0.0
OMNININJA_PORT=8000
OMNININJA_DOMAIN=omnininja-agent-os.gbvinidutra.chatgpt.site
OMNININJA_SEARCH_PROVIDER=duckduckgo
