{
  "name": "omnininja-ai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "imports": {
    "#omninininja/db": "./src/lib/db.ts",
    "#omninininja/sandbox": "./src/lib/sandbox.ts",
    "#omninininja/shell-agent": "./src/lib/shell-agent.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:node && npm run build:sites",
    "build:node": "next build && node scripts/prepare-standalone.mjs",
    "build:sites": "prisma generate && vinext build",
    "dev:sites": "vinext dev",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "start:sites": "vinext start",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "jose": "6.2.8",
    "lucide-react": "^0.525.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "react-server-dom-webpack": "19.2.8",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.120.1"
  }
}
