// OmniNinja — Prisma schema (PostgreSQL)
// Autonomous AI agent platform: users, tasks, messages, credits, integrations,
// projects, artifacts, and an append-only event stream for replay.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  tier          String   @default("free") // free | pro | business | team | enterprise
  credits       Int      @default(300)
  bonusCredits  Int      @default(1000)
  role          String   @default("user") // user | admin
  defaultModel  String   @default("glm")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks         Task[]
  messages      Message[]
  projects      Project[]
  creditTxns    CreditTransaction[]
  sessions      Session[]
  scheduled     ScheduledTask[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#38bdf8")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  goal        String
  mode        String   @default("agent") // chat | agent | agent_max
  model       String   @default("glm")
  status      String   @default("queued") // queued | planning | running | awaiting_input | completed | failed | cancelled
  summary     String?
  creditsUsed Int      @default(0)
  stepsTotal  Int      @default(0)
  stepsDone   Int      @default(0)
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  messages    Message[]
  events      EventRow[]
  artifacts   Artifact[]
}

model Message {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        String   // user | assistant | system | tool
  content     String
  model       String?
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  createdAt   DateTime @default(now())
}

model EventRow {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        String   // TASK_STARTED | PLAN_CREATED | STEP_STARTED | AGENT_THINKING | BROWSER_ACTION | TERMINAL_OUTPUT | FILE_CHANGED | STEP_COMPLETED | MODEL_FALLBACK | TASK_COMPLETED | TASK_FAILED
  payload     String   // JSON string
  ts          DateTime @default(now())

  @@index([taskId, ts])
}

model Artifact {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name        String
  kind        String   // file | site | image | report | archive
  path        String
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Scheduled / recurring tasks
model ScheduledTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  prompt      String
  mode        String   @default("agent") // chat | agent | agent_max
  model       String   @default("glm")
  schedule    String   // cron-like: 'daily 09:00' | 'weekly mon 10:00' | 'every 2h' | 'once 2026-08-01 14:00'
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runsCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta       Int      // negative = consumed, positive = granted/purchased
  reason      String   // task_run | daily_bonus | purchase | refund | monthly_grant
  taskId      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Tracks which integration/provider keys are configured (bool only — never the key).
model Integration {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. OPENROUTER_CLAUDE_API_KEY, BROWSERLESS_API_KEY
  label       String
  category    String   // llm | browser | search | infra | auth | billing
  configured  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
