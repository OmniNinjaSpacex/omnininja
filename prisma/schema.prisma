// OMNININJA — PostgreSQL schema
// Product model is always OMNININJA; OpenAI is the private model provider.
// AI Lab is optional isolated infrastructure for persistent execution tasks.

generator client {
  provider = "prisma-client-js"
}

// Cloudflare/Sites uses the JavaScript query engine with Neon's edge driver.
// The default generator above remains the source for Node.js and Docker.
generator edgeClient {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-edge"
  engineType   = "client"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  tier          String   @default("free")
  credits       Int      @default(300)
  bonusCredits  Int      @default(1000)
  role          String   @default("user")
  defaultModel  String   @default("OMNININJA")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks         Task[]
  messages      Message[]
  projects      Project[]
  creditTxns    CreditTransaction[]
  sessions      Session[]
  scheduled     ScheduledTask[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model OAuthState {
  id           String   @id
  provider     String
  codeVerifier String
  nonce        String?
  returnTo     String   @default("/")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId, expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#38bdf8")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@index([userId, updatedAt])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  goal        String
  mode        String   @default("chat")
  model       String   @default("OMNININJA")
  status      String   @default("queued")
  summary     String?
  creditsUsed Int      @default(0)
  stepsTotal  Int      @default(0)
  stepsDone   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  pinnedAt    DateTime?
  branchedFromId String?

  messages    Message[]
  events      EventRow[]
  artifacts   Artifact[]
  creditTxns  CreditTransaction[]

  @@index([userId, createdAt])
  @@index([userId, pinnedAt, updatedAt])
  @@index([projectId, createdAt])
}

model Message {
  id            String   @id @default(cuid())
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role          String
  content       String
  model         String?
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  embeddingJson String?
  attachmentsJson String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model EventRow {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        String
  payload     String
  ts          DateTime @default(now())

  @@index([taskId, ts])
}

model Artifact {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  path        String
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([kind, path])
}

model ScheduledTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  prompt      String
  mode        String   @default("work")
  model       String   @default("OMNININJA")
  schedule    String
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runsCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, nextRunAt])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta       Int
  reason      String
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

model Integration {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  category    String
  configured  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
